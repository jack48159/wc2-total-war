  "scenarioEvents": {
    "definitions": [
      {
        "id": "phony_war_end",
        "type": "notice",
        "trigger": "roundBegin",
        "conditions": [
          {
            "type": "any",
            "conditions": [
              { "type": "round", "value": 6, "op": "gte" },
              { "type": "countryDefeated", "country": "pl" },
              { "type": "areaOwnerNot", "area": 127, "country": "pl" }
            ]
          }
        ],
        "title": "假战结束",
        "body": "假战结束：英法开始对德全面作战。",
        "actions": [
          {
            "type": "setVariable",
            "key": "phony_war_active",
            "value": false
          }
        ]
      },
      {
        "id": "churchill_government",
        "type": "notice",
        "trigger": "roundBegin",
        "conditions": [
          { "type": "round", "value": 10, "op": "gte" }
        ],
        "title": "丘吉尔组阁",
        "body": "张伯伦下台，丘吉尔出任首相。英国转入战时内阁，国内稳定度上升。",
        "actions": [
          {
            "type": "changeStability",
            "country": "gb",
            "amount": 8,
            "reason": "churchill_government"
          }
        ]
      },
      {
        "id": "italy_enters_war",
        "type": "notice",
        "trigger": "roundBegin",
        "conditions": [
          {
            "type": "any",
            "conditions": [
              {
                "type": "round",
                "value": 12,
                "op": "gte"
              },
              {
                "type": "areaOwnerAlliedWith",
                "area": 1121,
                "country": "de"
              }
            ]
          }
        ],
        "title": "意大利参战",
        "body": "意大利正式加入战局，向英法宣战！",
        "actions": [
          {
            "type": "setDiplomacy",
            "first": "it",
            "second": "gb",
            "state": "war",
            "reason": "italy_enters_war"
          },
          {
            "type": "setDiplomacy",
            "first": "it",
            "second": "fr",
            "state": "war",
            "reason": "italy_enters_war"
          }
        ]
      },
      {
        "id": "barbarossa_round30",
        "type": "notice",
        "trigger": "roundBegin",
        "conditions": [
          {
            "type": "round",
            "value": 30,
            "op": "gte"
          },
          {
            "type": "diplomaticRelation",
            "first": "de",
            "second": "ru",
            "state": "peace"
          }
        ],
        "title": "苏德战争爆发",
        "body": "苏联红军发起全面反击，对德国宣战！",
        "actions": [
          {
            "type": "setDiplomacy",
            "first": "ru",
            "second": "de",
            "state": "war",
            "reason": "barbarossa"
          }
        ]
      }
    ],
    "variables": {
      "phony_war_active": true
    }
  },
